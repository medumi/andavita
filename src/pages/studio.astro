---
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Andavita · Videovorlagen</title>
    <link rel="icon" href="/assets/flower.svg" />
    <link rel="stylesheet" href="/style.css" />
    <style>
      body{padding:30px 5%}
      header{display:flex;justify-content:space-between;align-items:center;margin-bottom:35px}
      header a{font-size:14px}
      .studio-brand{font:800 28px var(--sans);letter-spacing:-1px}
      h1{font:46px var(--serif);margin:10px 0 15px}
      p{color:var(--muted);font-size:16px;max-width:850px}
      h2{font:30px var(--serif);margin-bottom:16px}
      .studio-grid{display:grid;grid-template-columns:1fr 1fr;gap:28px;margin:35px 0}
      .studio-card{border:1px solid var(--line);border-radius:20px;background:white;padding:24px}
      .studio-card video{width:100%;border-radius:12px;background:var(--deep);margin-bottom:16px}
      .studio-card p{font-size:14px;margin:10px 0}
      .downloads{display:flex;gap:15px;flex-wrap:wrap}
      .downloads a{font-size:14px}
      .editor{display:grid;grid-template-columns:1fr 1.3fr;gap:30px;margin:40px 0}
      .editor input,.editor select{width:100%}
      .lower-preview{position:relative;min-height:290px;border-radius:18px;background:linear-gradient(45deg,#e4e6df 25%,transparent 25%,transparent 75%,#e4e6df 75%),linear-gradient(45deg,#e4e6df 25%,#f6f7f3 25%,#f6f7f3 75%,#e4e6df 75%);background-size:24px 24px;background-position:0 0,12px 12px;overflow:hidden;display:flex;align-items:flex-end;padding:35px}
      .lower-overlay{padding:20px 28px;background:#fbfaf7;border-left:5px solid #f7c873;box-shadow:0 10px 30px #214e4915;border-radius:10px;min-width:75%;animation:reveal 1s ease both}
      .lower-overlay strong{font:35px var(--serif);display:block}
      .lower-overlay span{font-size:16px;color:#476455;display:block;margin-top:7px}
      @keyframes reveal{from{opacity:0;transform:translateX(-40px)}to{opacity:1;transform:translateX(0)}}
      .studio-note{padding:20px;background:#eef1e6;border-radius:13px;font-size:14px;line-height:1.7}
      .template-foot{margin:35px 0;font-size:13px}
      .editor-actions{display:flex;gap:10px;flex-wrap:wrap}
      @media(max-width:700px){
        body{padding:25px 6%}
        .studio-grid,.editor{grid-template-columns:1fr}
        .studio-card{padding:19px}
        h1{font-size:37px}
        .lower-preview{min-height:240px;padding:22px}
        .lower-overlay strong{font-size:29px}
      }
    </style>
  </head>
  <body>
    <header>
      <a class="studio-brand" href="/">andavita</a>
      <a href="/">Zur Webseite ↗</a>
    </header>
    <span class="eyebrow">DEIN VIDEO-BAUKASTEN</span>
    <h1>Ein gemeinsamer Rahmen.<br />Für jeden guten Moment.</h1>
    <p>Animierte Intros, Outros und Bauchbinden im Andavita-Look. Zur direkten Verwendung im Videoschnitt – ohne Musik, damit du deine eigene Tonspur durchgehend nutzen kannst.</p>

    <div class="studio-grid">
      <section class="studio-card">
        <h2>Intro · 5 Sekunden</h2>
        <video controls playsinline preload="metadata" poster="/media/intro.png" src="/media/intro.mp4"></video>
        <p>1920 × 1080 · 25 Bilder/s · MP4</p>
        <div class="downloads"><a class="btn" href="/media/intro.mp4" download>Intro herunterladen ↓</a></div>
      </section>
      <section class="studio-card">
        <h2>Outro · 6 Sekunden</h2>
        <video controls playsinline preload="metadata" poster="/media/outro.png" src="/media/outro.mp4"></video>
        <p>1920 × 1080 · 25 Bilder/s · MP4</p>
        <div class="downloads"><a class="btn" href="/media/outro.mp4" download>Outro herunterladen ↓</a></div>
      </section>
      <section class="studio-card">
        <h2>Bauchbinde · 8 Sekunden</h2>
        <video controls playsinline preload="metadata" poster="/media/bauchbinde-vorschau.png" src="/media/bauchbinde-vorschau.mp4"></video>
        <p>Mit sanftem Ein- und Ausblenden. Die MOV-Datei enthält Transparenz; in der Vorschau siehst du sie auf Meergrün.</p>
        <div class="downloads">
          <a class="btn" href="/media/bauchbinde-transparent.mov" download>Transparente MOV ↓</a>
          <a class="text-link" href="/media/bauchbinde-vorschau.mp4" download>MP4-Vorschau ↓</a>
        </div>
      </section>
      <section class="studio-card">
        <h2>Bevor du beginnst · 22 Sekunden</h2>
        <video controls playsinline preload="metadata" poster="/media/sicherheit.png" src="/media/sicherheit.mp4"></video>
        <p>Eine ruhig eingeblendete Sicherheitstafel vor der Praxis. Als einzelner Baustein oder zusammen mit dem Markenintro.</p>
        <div class="downloads">
          <a class="btn" href="/media/intro-sicherheit.mp4" download>Intro + Sicherheit · 27 s ↓</a>
          <a class="text-link" href="/media/sicherheit.mp4" download>Sicherheitstafel ↓</a>
        </div>
        <p>Textentwurf zur fachlichen und rechtlichen Prüfung. Kein pauschaler Haftungsausschluss; kursspezifische Hinweise ergänzen.</p>
      </section>
      <section class="studio-card">
        <h2>So verwendest du die Vorlagen</h2>
        <p><b>Intro:</b> Vor den Kurs setzen, danach die Sicherheitstafel. Der kombinierte Download enthält beide Bausteine.</p>
        <p><b>Bauchbinde:</b> Die transparente MOV in einer Videospur über das Kursvideo legen. Der Name erscheint unten links. Beispielrolle: „Bewegung & Entspannung" – keine unbestätigte Qualifikationsangabe.</p>
        <p><b>Outro:</b> Hinter den Kurs setzen.</p>
        <p>Die Vorlagen passen zu einem 16:9-Kursvideo. Für Hochkantvideos müssen Position und Größe angepasst werden.</p>
      </section>
    </div>

    <section>
      <h2>Deine Bauchbinde anpassen</h2>
      <p>Teste hier Name und Text. Die Downloads oben bleiben die fertige Nina-Vorlage. Deine Konfiguration kannst du für einen neuen Videoexport speichern.</p>
      <div class="editor">
        <form id="template-form">
          <label class="field">Name<input id="name" value="Nina" maxlength="32" /></label>
          <label class="field">Funktion / Beschreibung<input id="role" value="Bewegung & Entspannung" maxlength="45" /></label>
          <div class="editor-actions">
            <button class="btn" type="submit">Animation ansehen</button>
            <button class="btn light" type="button" id="download-config">Vorlage speichern ↓</button>
          </div>
        </form>
        <div class="lower-preview">
          <img src="/assets/flower.svg" alt="" style="position:absolute;right:24px;top:20px;width:52px" />
          <div class="lower-overlay" id="overlay">
            <strong id="preview-name">Nina</strong>
            <span id="preview-role">Bewegung & Entspannung</span>
          </div>
        </div>
      </div>
    </section>
    <p class="studio-note">Die editierbare Konfiguration enthält nur Namen und Texte. Der beiliegende Renderer erstellt daraus neue MP4-/MOV-Dateien. Diese Vorschau lädt keine Kursvideos hoch und veröffentlicht keine Inhalte.</p>
    <p style="margin-top:24px"><a class="btn light" href="/media/andavita-vorlagen-quellen.zip" download>Bearbeitbare Vorlagen & Renderer ↓</a></p>
    <p class="template-foot">Andavita · Videovorlagen, Version 2 · mit Blume · 1920 × 1080 · ohne Audiospur</p>

    <script is:inline>
      const form=document.querySelector('#template-form');
      function update(){
        document.querySelector('#preview-name').textContent=document.querySelector('#name').value;
        document.querySelector('#preview-role').textContent=document.querySelector('#role').value;
      }
      form.addEventListener('input',update);
      form.onsubmit=e=>{
        e.preventDefault();
        update();
        document.querySelector('#overlay').animate([{opacity:0,transform:'translateX(-40px)'},{opacity:1,transform:'translateX(0)'}],{duration:1000,easing:'ease-out'});
      };
      document.querySelector('#download-config').onclick=()=>{
        const config={
          safety:{title:"Bevor du beginnst.",lines:["Übe in deinem Tempo und ohne Schmerzen.","Bei Schmerzen, Schwindel oder Unwohlsein beende die Übung.","Bei Erkrankungen, Verletzungen oder Unsicherheit","kläre die Teilnahme vorab ärztlich.","Die Inhalte ersetzen keine medizinische Beratung oder Behandlung."]},
          intro:{title:'Dein Moment beginnt.',subtitle:'Bewegung. Ruhe. Ganz bei dir.'},
          outro:{title:'Nimm dieses gute Gefühl mit.',subtitle:'Bis zu deinem nächsten Moment bei Andavita.'},
          lowerThird:{name:document.querySelector('#name').value,role:document.querySelector('#role').value}
        };
        const url=URL.createObjectURL(new Blob([JSON.stringify(config,null,2)],{type:'application/json'}));
        const a=document.createElement('a');
        a.href=url;
        a.download='andavita-videovorlage.json';
        a.click();
        setTimeout(()=>URL.revokeObjectURL(url),1000);
      };
    </script>
  </body>
</html>
