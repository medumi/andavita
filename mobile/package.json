{
  "name": "andavita-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Andavita – iOS- und Android-Prototyp mit gemeinsamem Mitgliederbereich",
  "scripts": {
    "build": "node scripts/build.mjs",
    "sync": "npm run build && cap sync",
    "ios": "cap open ios",
    "android": "cap open android",
    "android:build": "sh scripts/android-build.sh",
    "ios:build": "sh scripts/ios-build.sh"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.2",
    "@capacitor/ios": "8.5.2",
    "@capacitor/local-notifications": "8.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "esbuild": "0.28.2"
  }
}
